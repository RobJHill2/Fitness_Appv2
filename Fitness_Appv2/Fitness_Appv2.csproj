<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <ProduceReferenceAssemblyInOutDir>true</ProduceReferenceAssemblyInOutDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <Optimize>False</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
    <PackageReference Include="Syncfusion.Licensing" Version="26.2.13" />
    <PackageReference Include="Syncfusion.Xamarin.SfChart" Version="26.2.13" />
    <PackageReference Include="Xamarin.Forms" Version="5.0.0.2662" />  
    <PackageReference Include="Xamarin.Essentials" Version="1.8.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Views\AddSets.xaml">
      <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Views\Page1.xaml">
      <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Models\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\DefineNewRoutine.xaml.cs">
      <DependentUpon>DefineNewRoutine.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\Xcises.xaml.cs">
      <DependentUpon>Xcises.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\Routines.xaml.cs">
      <DependentUpon>Routines.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\Stats.xaml.cs">
      <DependentUpon>Stats.xaml</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>